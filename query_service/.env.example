# Copy to query_service/.env and fill in — values come from `terraform
# output` in infra/ (ecs_cluster_name, ecs_task_definition_family) plus
# whatever subnets/security group the deploy workflow's GitHub Environment
# variables use (ECS_SUBNETS/ECS_SECURITY_GROUPS — see .github/workflows/
# deploy.yml and airflow/dags/dbt_lakehouse_dag.py, which hardcode the same
# values for the same reason: they rarely change once set).
LANDING_BUCKET=aws-dbt-duckdb-landing-770724966330
ECS_CLUSTER=aws-duckdb-lakehouse-dev
ECS_TASK_DEFINITION_FAMILY=aws-duckdb-lakehouse-dev
ECS_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUPS=sg-xxxxxxxx
AWS_REGION=us-east-1
